local spamming = false

StartBtn.MouseButton1Click:Connect(function()
	if not spamming then
		spamming = true
		StartBtn.Text = "● RUNNING..."
		StatusLabel.Text = "● STATUS: RUNNING"
		StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)

		task.spawn(function()
			while spamming do
				local targets = {}
				if TargetBox1.Text ~= "" then table.insert(targets, TargetBox1.Text) end
				if TargetBox2.Text ~= "" then table.insert(targets, TargetBox2.Text) end
				if TargetBox3.Text ~= "" then table.insert(targets, TargetBox3.Text) end
				if TargetBox4.Text ~= "" then table.insert(targets, TargetBox4.Text) end

				if #targets == 0 then table.insert(targets, "Target") end

				for _, targetName in ipairs(targets) do
					if not spamming then break end

					local currentList = cycleEnabled and combinedPresets or symbolPresets[activeSymbol]
					local rawPreset = currentList[presetIndex]
					
					local prefix = "@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@"
					if cycleEnabled then
						if presetIndex <= 3 then
							prefix = "@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@"
						elseif presetIndex <= 6 then
							prefix = "[/===/////===/////===/////===/////===/////===/////===/////===/////===] "
						else
							prefix = "[+++-------+++-------+++-------+++-------+++-------+++-------+++] "
						end
					else
						if activeSymbol == "SlashSign" then
							prefix = "[/===/////===/////===/////===/////===/////===/////===/////===/////===] "
						elseif activeSymbol == "PlusSign" then
							prefix = "[+++-------+++-------+++-------+++-------+++-------+++-------+++] "
						end
					end

					local finalMsg = prefix .. rawPreset:gsub("%[target name%]", targetName):gsub("%[Target name%]", targetName):gsub("%[Target Name%]", targetName):gsub("%[TargetName%]", targetName)

					if emojiEnabled then
						local randomEmoji = emojis[math.random(1, #emojis)]
						finalMsg = finalMsg .. " " .. randomEmoji
					end

					sendMessage(finalMsg)

					presetIndex = presetIndex + 1
					if presetIndex > #currentList then
						presetIndex = 1
					end

					local delayTime = tonumber(DelayBox.Text) or 1.5
					if delayTime < 0.1 then delayTime = 0.1 end
					if delayTime > 10 then delayTime = 10 end

					task.wait(delayTime)
				end
			end
		end)
	end
end)

